# 复制为 .env.local 后填写；.env.local 已被 gitignore，不要提交。

# 是否调用真实 AI。false / 不设置 = 使用内置模拟数据
VITE_USE_REAL_AI=false

# 只有把 api/chat.js 部署到别处时才需要填；Vercel 同域部署留空
VITE_API_BASE=

# 以下变量只在服务端（Vercel 环境变量）使用，不要加 VITE_ 前缀，否则会打进前端
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_MODEL=gpt-4o-mini
